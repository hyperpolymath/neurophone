Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Build
/target/
/_build/
/build/
/dist/
/out/

# Dependencies
/node_modules/
/vendor/
/deps/
/.elixir_ls/

# Rust

# Elixir
/cover/
/doc/
*.ez
erl_crash.dump

# Julia
*.jl.cov
*.jl.mem
/Manifest.toml

# ReScript
/lib/bs/
/.bsb.lock

# Python (SaltStack only)
__pycache__/
*.py[cod]
.venv/

# Ada/SPARK
*.ali
/obj/
/bin/

# Haskell
/.stack-work/
/dist-newstyle/

# Chapel
*.chpl.tmp.*

# Secrets
.env
.env.*
*.pem
*.key
secrets/

# Test/Coverage
/coverage/
htmlcov/

# Logs
*.log
/logs/

# Temp
/tmp/
*.tmp
*.bak
target/
node_modules/
_build/
deps/
.elixir_ls/
.cache/
build/
dist/

# TLA+ model-checker jar cache (fetched by `just proof-tla`)
.tlacache/

# Dafny release cache (fetched by `just proof-dafny`)
.dafnycache/

# Lean/Lake build cache and vendored Mathlib checkout (fetched/built by
# `just proof-lean`); see proofs/lean/.gitignore.
proofs/lean/.lake/
