{
  "$schema": "https://gossamer.dev/schemas/config/v1",
  "_comment": "SPDX-License-Identifier: MPL-2.0 — Gossamer app config for NeuroPhone Android. Analogous to tauri.conf.json. Scaffolding only (epic #83, RFC PR #97, sub-issue #109, sub-PR #3). Schema mirrored from hyperpolymath/gossamer gossamer.conf.json and hyperpolymath/panll gossamer.conf.json.",
  "productName": "NeuroPhone",
  "version": "1.0.0",
  "identifier": "ai.neurophone",
  "build": {
    "frontendDist": "./public",
    "devUrl": "http://localhost:8000/",
    "beforeDevCommand": "deno task dev",
    "beforeBuildCommand": "deno task build",
    "runner": "deno",
    "watch": {
      "paths": ["public/", "src/"],
      "extensions": [".html", ".js", ".css"],
      "debounceMs": 300
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NeuroPhone",
        "width": 1080,
        "height": 1920,
        "resizable": false,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": true,
        "url": "/"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["network", "notification"],
      "capabilityTokens": {
        "enabled": false,
        "issuer": "gossamer-runtime",
        "ttl": 3600
      },
      "sandbox": {
        "enabled": true,
        "allowExec": false,
        "allowNetwork": true,
        "allowFilesystem": false
      }
    },
    "ipc": {
      "protocol": "json",
      "bridgeInjection": true,
      "maxMessageSize": 16777216,
      "timeout": 30000
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": ["apk"],
    "copyright": "Copyright (c) 2026 Jonathan D.A. Jewell (hyperpolymath)",
    "license": "MPL-2.0",
    "shortDescription": "NeuroSymbolic Phone — on-device LSM/ESN reservoir computing.",
    "mobile": {
      "android": {
        "minimumSdk": 26,
        "targetSdk": 34,
        "permissions": [
          "android.permission.INTERNET",
          "android.permission.BODY_SENSORS",
          "android.permission.HIGH_SAMPLING_RATE_SENSORS",
          "android.permission.FOREGROUND_SERVICE",
          "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
          "android.permission.POST_NOTIFICATIONS",
          "android.permission.RECEIVE_BOOT_COMPLETED",
          "android.permission.WAKE_LOCK"
        ],
        "features": []
      }
    }
  },
  "ephapax": {
    "modules": [],
    "region": "app",
    "linearVerification": true,
    "regionBoundary": "strict",
    "preload": []
  }
}
