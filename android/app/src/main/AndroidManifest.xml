  Surface + permission set mirrors docs/OS_INTEGRATION.adoc exactly; kept in
  sync deliberately so that doc stays the single source of truth for "what
  the app touches on the platform".

  STAGED / UNVERIFIED ON-DEVICE: no Android SDK/NDK/aapt2 is available in the
  environment this manifest was authored in, so this file has not been run
  through a real manifest merger or installed on a device or emulator. It is
  reviewed for correctness against the Android platform docs and the deleted
  legacy manifest (recoverable via `git show f389983^:android/app/src/main/AndroidManifest.xml`
  from before the Kotlin-removal commit), not executed.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.neurophone">

    <!-- Sensor stream (docs/OS_INTEGRATION.adoc "Permissions"). -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- Claude cloud fallback, only used when enabled. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Long-running sensor -> LSM -> ESN -> bridge -> LLM pipeline. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Service-status notification (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Restart the pipeline after reboot if the user had it running. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Keep the CPU on for the rare frames where 50 Hz sampling would miss. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.NoTitleBar">

        <activity
            android:name=".NeurophoneActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press-home ASSIST surface, per docs/OS_INTEGRATION.adoc. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Share-sheet target for plain-text "Share" actions. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- neurophone://query?q=... deep link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="neurophone" android:host="query" />
            </intent-filter>
        </activity>

        <service
            android:name=".NeurophoneService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.NeurophoneAppWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/neurophone_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NeurophoneWidgetActions"
            android:exported="false" />

    </application>
</manifest>
